@backend_HostAddress = http://localhost:5273

### Login (Gets JWT Token)
# @name login
POST {{backend_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "dawood@admin.com",
  "password": "Admin@123"
}

###

@token = {{login.response.body.token}}

### Register a new Customer (Public)
POST {{backend_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "Customer_1",
  "email": "customer1@test.com",
  "password": "Customer@123"
}

###

### Create a new User (Manager Only)
POST {{backend_HostAddress}}/api/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": "new_sales_rep",
  "email": "sales_new@test.com",
  "password": "Sales123",
  "role": "SalesRep"
}

###

GET {{backend_HostAddress}}/api/customers?page=1&pageSize=10
Authorization: Bearer {{token}}

###

POST {{backend_HostAddress}}/api/customers
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Ali Raza",
  "email": "ali.raza@example.com",
  "company": "Raza Tech",
  "address": "Lahore, Pakistan"
}

